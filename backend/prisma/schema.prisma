datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  PADRAO
}

enum TipoPedido {
  PRESENCIAL
  RETIRADA
  ENTREGA
}

enum StatusPedido {
  REALIZADO
  SENDO_FEITO
  PRONTO
  EM_ROTA
  CONCLUIDO
  CANCELADO
}

enum ModoPersonalizacao {
  RETIRAR
  SOMENTE
}

enum MetodoPagamento {
  DINHEIRO
  PIX
  CARTAO_CREDITO
  CARTAO_DEBITO
  VALE_REFEICAO
  OUTRO
}

enum StatusCaixa {
  ABERTO
  FECHADO
}

enum CategoriaProduto {
  TRADICIONAIS
  PRENSADOS
  BEBIDAS
  PORCOES
  OUTROS
}

enum DirecaoMensagem {
  ENTRADA
  SAIDA
}

enum StatusSessaoWhatsapp {
  DESCONECTADO
  QRCODE_DISPONIVEL
  CONECTADO
}

model Usuario {
  id              String      @id @default(uuid())
  nome            String
  email           String      @unique
  senha           String
  cargo           Role        @default(PADRAO)
  ativo           Boolean     @default(true)
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt

  caixas_abertos    Caixa[]   @relation("CaixaAbertura")
  caixas_fechados   Caixa[]   @relation("CaixaFechamento")
  pedidos_atendidos Pedido[]

  @@map("usuarios")
}

model Caixa {
  id                      String       @id @default(uuid())
  usuario_abertura_id     String
  usuario_fechamento_id   String?
  data_abertura           DateTime     @default(now())
  data_fechamento         DateTime?
  status                  StatusCaixa  @default(ABERTO)

  fundo_abertura          Decimal      @db.Decimal(10, 2)
  saldo_dinheiro_calculado Decimal?    @db.Decimal(10, 2)
  saldo_dinheiro_informado Decimal?    @db.Decimal(10, 2)
  diferenca_caixa         Decimal?     @db.Decimal(10, 2)
  observacoes             String?      @db.Text

  created_at              DateTime     @default(now())
  updated_at              DateTime     @updatedAt

  usuario_abertura        Usuario      @relation("CaixaAbertura", fields: [usuario_abertura_id], references: [id])
  usuario_fechamento      Usuario?     @relation("CaixaFechamento", fields: [usuario_fechamento_id], references: [id])
  pedidos                 Pedido[]
  acertos_motoboys        AcertoMotoboy[]

  @@map("caixas")
}

model Ingrediente {
  id              String                  @id @default(uuid())
  nome            String                  @unique
  estoque_atual   Decimal                 @default(0) @db.Decimal(10, 3)
  unidade_medida  String                  @default("UN")
  ativo           Boolean                 @default(true)
  created_at      DateTime                @default(now())
  updated_at      DateTime                @updatedAt

  fichas_tecnicas     ProdutoFichaTecnica[]
  itens_removidos     ItemRemovido[]
  itens_inclusos      ItemIncluso[]
  adicional_vinculado Adicional?

  @@map("ingredientes")
}

model Produto {
  id              String                  @id @default(uuid())
  nome            String                  @unique
  descricao       String?                 @db.Text
  categoria       CategoriaProduto        @default(PRENSADOS)
  preco           Decimal                 @db.Decimal(10, 2)
  ativo           Boolean                 @default(true)
  ordem_exibicao  Int                     @default(0)
  created_at      DateTime                @default(now())
  updated_at      DateTime                @updatedAt

  ficha_tecnica   ProdutoFichaTecnica[]
  itens_pedido    ItemPedido[]

  @@map("produtos")
}

model ProdutoFichaTecnica {
  id                 String       @id @default(uuid())
  produto_id         String
  ingrediente_id     String
  quantidade_padrao  Decimal      @default(1) @db.Decimal(10, 3)

  produto            Produto      @relation(fields: [produto_id], references: [id], onDelete: Cascade)
  ingrediente        Ingrediente  @relation(fields: [ingrediente_id], references: [id], onDelete: Restrict)

  @@unique([produto_id, ingrediente_id])
  @@map("produto_ficha_tecnica")
}

model Adicional {
  id              String                  @id @default(uuid())
  nome            String                  @unique
  preco           Decimal                 @db.Decimal(10, 2)
  ingrediente_id  String?                 @unique
  ativo           Boolean                 @default(true)
  created_at      DateTime                @default(now())
  updated_at      DateTime                @updatedAt

  ingrediente     Ingrediente?            @relation(fields: [ingrediente_id], references: [id])
  itens_adicionais ItemPedidoAdicional[]

  @@map("adicionais")
}

model Cliente {
  id                  String             @id @default(uuid())
  nome                String
  telefone            String             @unique
  opt_in_whatsapp     Boolean            @default(true)
  total_pedidos       Int                @default(0)
  created_at          DateTime           @default(now())
  updated_at          DateTime           @updatedAt

  enderecos           EnderecoCliente[]
  pedidos             Pedido[]
  historico_mensagens HistoricoMensagem[]

  @@map("clientes")
}

model EnderecoCliente {
  id              String      @id @default(uuid())
  cliente_id      String
  logradouro      String
  numero          String
  complemento     String?
  bairro          String
  cidade          String      @default("Palhoça")
  cep             String?
  ponto_referencia String?
  latitude        Float?
  longitude       Float?
  principal       Boolean     @default(true)
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt

  cliente         Cliente     @relation(fields: [cliente_id], references: [id], onDelete: Cascade)

  @@map("enderecos_cliente")
}

model TaxaPalhoca {
  id              String      @id @default(uuid())
  bairro          String      @unique
  valor_taxa      Decimal     @db.Decimal(10, 2)
  ativo           Boolean     @default(true)
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt

  @@map("taxas_palhoca")
}

model Entregador {
  id              String          @id @default(uuid())
  nome            String
  telefone        String
  placa_veiculo   String?
  ativo           Boolean         @default(true)
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt

  pedidos         Pedido[]
  acertos         AcertoMotoboy[]

  @@map("entregadores")
}

model Pedido {
  id                    String            @id @default(uuid())
  numero_diario         Int
  tipo_pedido           TipoPedido        @default(PRESENCIAL)
  status                StatusPedido      @default(REALIZADO)
  
  cliente_id            String?
  usuario_id            String
  caixa_id              String
  entregador_id         String?

  entrega_logradouro    String?
  entrega_numero        String?
  entrega_complemento   String?
  entrega_bairro        String?
  entrega_cidade        String?           @default("Palhoça")
  entrega_cep           String?
  entrega_referencia    String?
  entrega_latitude      Float?
  entrega_longitude     Float?
  link_rota_maps        String?           @db.Text

  valor_produtos        Decimal           @db.Decimal(10, 2)
  valor_adicionais      Decimal           @default(0) @db.Decimal(10, 2)
  valor_taxa_entrega    Decimal           @default(0) @db.Decimal(10, 2)
  valor_desconto        Decimal           @default(0) @db.Decimal(10, 2)
  valor_total           Decimal           @db.Decimal(10, 2)

  troco_para            Decimal?          @db.Decimal(10, 2)
  valor_troco_calculado Decimal?          @db.Decimal(10, 2)

  observacoes_gerais    String?           @db.Text
  motivo_cancelamento   String?           @db.Text
  retornou_ao_estoque   Boolean           @default(false)

  created_at            DateTime          @default(now())
  tempo_inicio_preparo  DateTime?
  tempo_pronto          DateTime?
  tempo_saida_entrega   DateTime?
  tempo_concluido       DateTime?
  updated_at            DateTime          @updatedAt

  cliente               Cliente?          @relation(fields: [cliente_id], references: [id])
  usuario               Usuario           @relation(fields: [usuario_id], references: [id])
  caixa                 Caixa             @relation(fields: [caixa_id], references: [id])
  entregador            Entregador?       @relation(fields: [entregador_id], references: [id])
  itens                 ItemPedido[]
  pagamentos            PagamentoPedido[]

  @@index([status])
  @@index([created_at])
  @@map("pedidos")
}

model ItemPedido {
  id                    String              @id @default(uuid())
  pedido_id             String
  produto_id            String
  quantidade            Int                 @default(1)
  preco_unitario        Decimal             @db.Decimal(10, 2)
  subtotal              Decimal             @db.Decimal(10, 2)

  modo_personalizacao   ModoPersonalizacao  @default(RETIRAR)
  observacao_item       String?             @db.Text

  created_at            DateTime            @default(now())

  pedido                Pedido              @relation(fields: [pedido_id], references: [id], onDelete: Cascade)
  produto               Produto             @relation(fields: [produto_id], references: [id])
  itens_removidos       ItemRemovido[]
  itens_inclusos        ItemIncluso[]
  adicionais            ItemPedidoAdicional[]

  @@map("itens_pedido")
}

model ItemRemovido {
  id              String        @id @default(uuid())
  item_pedido_id  String
  ingrediente_id  String

  item_pedido     ItemPedido    @relation(fields: [item_pedido_id], references: [id], onDelete: Cascade)
  ingrediente     Ingrediente   @relation(fields: [ingrediente_id], references: [id], onDelete: Restrict)

  @@unique([item_pedido_id, ingrediente_id])
  @@map("itens_removidos")
}

model ItemIncluso {
  id              String        @id @default(uuid())
  item_pedido_id  String
  ingrediente_id  String

  item_pedido     ItemPedido    @relation(fields: [item_pedido_id], references: [id], onDelete: Cascade)
  ingrediente     Ingrediente   @relation(fields: [ingrediente_id], references: [id], onDelete: Restrict)

  @@unique([item_pedido_id, ingrediente_id])
  @@map("itens_inclusos")
}

model ItemPedidoAdicional {
  id              String        @id @default(uuid())
  item_pedido_id  String
  adicional_id    String
  quantidade      Int           @default(1)
  preco_unitario  Decimal       @db.Decimal(10, 2)
  subtotal        Decimal       @db.Decimal(10, 2)

  item_pedido     ItemPedido    @relation(fields: [item_pedido_id], references: [id], onDelete: Cascade)
  adicional       Adicional     @relation(fields: [adicional_id], references: [id], onDelete: Restrict)

  @@map("item_pedido_adicionais")
}

model PagamentoPedido {
  id                String          @id @default(uuid())
  pedido_id         String
  metodo_pagamento  MetodoPagamento
  valor_pago        Decimal         @db.Decimal(10, 2)
  created_at        DateTime        @default(now())

  pedido            Pedido          @relation(fields: [pedido_id], references: [id], onDelete: Cascade)

  @@map("pagamentos_pedido")
}

model AcertoMotoboy {
  id                      String      @id @default(uuid())
  caixa_id                String
  entregador_id           String
  total_entregas          Int
  total_dinheiro_recebido Decimal     @db.Decimal(10, 2)
  total_taxas_repassar    Decimal     @db.Decimal(10, 2)
  saldo_acertado          Decimal     @db.Decimal(10, 2)
  fechado_em              DateTime    @default(now())

  caixa                   Caixa       @relation(fields: [caixa_id], references: [id])
  entregador              Entregador  @relation(fields: [entregador_id], references: [id])

  @@map("acertos_motoboy")
}

model SessaoWhatsapp {
  id              String                @id @default(uuid())
  session_key     String                @unique @default("dog_house_pdv")
  status          StatusSessaoWhatsapp  @default(DESCONECTADO)
  qrcode_base64   String?               @db.Text
  numero_conectado String?
  updated_at      DateTime              @updatedAt

  @@map("sessoes_whatsapp")
}

model HistoricoMensagem {
  id              String          @id @default(uuid())
  cliente_id      String?
  telefone        String
  direcao         DirecaoMensagem
  conteudo        String          @db.Text
  lida            Boolean         @default(false)
  created_at      DateTime        @default(now())

  cliente         Cliente?        @relation(fields: [cliente_id], references: [id])

  @@index([telefone])
  @@index([created_at])
  @@map("historico_mensagens")
}
